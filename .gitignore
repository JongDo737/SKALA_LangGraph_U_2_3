# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Secrets and local configuration
.env
.env.*
!.env.example

# IDE and OS
.idea/
.vscode/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Local RAG indexes and caches
.chroma/
chroma_db/
vectorstore/
cache/
*cache*.json
data/*cache*.json

# Generated reports and local artifacts
outputs/*
!outputs/.gitkeep
data/pdfs/*
!data/pdfs/.gitkeep

# RAG 임베딩용 시장조사 PDF / zip 캐시 (git에 올리지 않음 — FOR_EMBED_ZIP_URL로 다운로드)
data/for_embed/*
!data/for_embed/.gitkeep
data/for_embed_zip/
*.pdf
!assets/**/*.pdf
